# Keep the build context tiny and free of host/runtime cruft.
.git
.github
node_modules
npm-debug.log*

# Runtime data (regenerable / personal) — never bake into the image
db.json
.thumbnails/
data/

# Local dev / editor
.claude
.env
.env.*
!.env.example

# Docs & samples not needed at runtime
README.md
ROADMAP.md
LICENSE
# Root-anchored: the top-level assets/ (source art) is dev-only. This must NOT
# sweep public/assets/ -- the served brand banners (v1.89 default logo) live at
# public/assets/brand/ and MUST ship in the image. `/assets` (leading slash)
# matches ONLY the context-root assets/, never a nested public/assets.
/assets
test_media
docker-compose.yml
