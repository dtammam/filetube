{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dtammam/filetube/docs/references/native-bridge.v1.schema.json",
  "title": "FileTube native bridge, contract v1",
  "description": "The authority for the web UI <-> native host contract (docs/references/native-bridge.md explains it). Add-only within v1.",
  "$defs": {
    "host": {
      "description": "window.FileTubeHost as injected by a native host before page scripts run.",
      "type": "object",
      "required": ["bridge", "app", "capabilities"],
      "properties": {
        "bridge": { "const": 1 },
        "app": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "build": { "type": "string" }
          }
        },
        "platform": { "type": "string" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["orientation", "haptics", "battery", "serverSettings", "statusBar", "network", "downloads", "mediaFetch", "nativeAudio"] }
        }
      }
    },
    "webToNative": {
      "description": "A message the web posts through FileTubeHost.post.",
      "type": "object",
      "required": ["v", "type"],
      "properties": { "v": { "const": 1 } },
      "oneOf": [
        { "properties": { "type": { "const": "host.hello" }, "web": { "type": "object", "required": ["version"], "properties": { "version": { "type": "string" } } } }, "required": ["web"] },
        { "properties": { "type": { "const": "orientation.lock" }, "orientation": { "const": "portrait" } }, "required": ["orientation"] },
        { "properties": { "type": { "const": "orientation.unlock" } } },
        { "properties": { "type": { "const": "haptics.prepare" } } },
        { "properties": { "type": { "const": "haptics.tick" }, "style": { "enum": ["detent", "letter", "snap"] }, "intensity": { "type": "number", "minimum": 0, "maximum": 1 } }, "required": ["style"] },
        { "properties": { "type": { "const": "battery.subscribe" } } },
        { "properties": { "type": { "const": "battery.unsubscribe" } } },
        { "properties": { "type": { "const": "host.openServerSettings" } } },
        { "properties": { "type": { "const": "statusBar.hide" } } },
        { "properties": { "type": { "const": "statusBar.show" } } },
        { "properties": { "type": { "const": "network.subscribe" } } },
        { "properties": { "type": { "const": "network.unsubscribe" } } },
        { "properties": { "type": { "const": "downloads.add" }, "kind": { "enum": ["track", "album", "podcastEpisode", "video", "tvEpisode", "tvSeason"] }, "id": { "type": "string", "minLength": 1, "maxLength": 512 } }, "required": ["kind", "id"] },
        { "properties": { "type": { "const": "downloads.remove" }, "kind": { "enum": ["track", "album", "podcastEpisode", "video", "tvEpisode", "tvSeason"] }, "id": { "type": "string", "minLength": 1, "maxLength": 512 } }, "required": ["kind", "id"] },
        { "properties": { "type": { "const": "downloads.subscribe" } } },
        { "properties": { "type": { "const": "downloads.unsubscribe" } } },
        { "properties": { "type": { "const": "downloads.show" } } },
        { "properties": { "type": { "const": "audio.load" }, "queue": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/audioItem" } }, "index": { "type": "number", "minimum": 0 }, "positionSec": { "type": "number", "minimum": 0 }, "autoplay": { "type": "boolean" }, "modes": { "$ref": "#/$defs/audioModes" }, "rate": { "type": "number", "minimum": 0.5, "maximum": 3 }, "rev": { "type": "number", "minimum": 0 } }, "required": ["queue", "index", "positionSec", "autoplay", "modes", "rate", "rev"] },
        { "properties": { "type": { "const": "audio.play" } } },
        { "properties": { "type": { "const": "audio.pause" } } },
        { "properties": { "type": { "const": "audio.seek" }, "positionSec": { "type": "number", "minimum": 0 } }, "required": ["positionSec"] },
        { "properties": { "type": { "const": "audio.skip" }, "to": { "enum": ["next", "previous"] } }, "required": ["to"] },
        { "properties": { "type": { "const": "audio.jump" }, "index": { "type": "number", "minimum": 0 } }, "required": ["index"] },
        { "properties": { "type": { "const": "audio.setModes" }, "modes": { "$ref": "#/$defs/audioModes" } }, "required": ["modes"] },
        { "properties": { "type": { "const": "audio.setRate" }, "rate": { "type": "number", "minimum": 0.5, "maximum": 3 } }, "required": ["rate"] },
        { "properties": { "type": { "const": "audio.sleep" }, "mode": { "enum": ["off", "minutes", "endOfItem"] }, "minutes": { "type": "number", "minimum": 1, "maximum": 720 } }, "required": ["mode"] },
        { "properties": { "type": { "const": "audio.stop" } } },
        { "properties": { "type": { "const": "audio.subscribe" } } },
        { "properties": { "type": { "const": "audio.unsubscribe" } } }
      ]
    },
    "audioItem": {
      "description": "v1.397.0 nativeAudio: one queue ITEM the web sends in audio.load and native echoes in every audioState. kind: a music track (a native track, a library audio file shown in Music, or one chapter of a chaptered file) or a podcast episode. src and artworkSrc are SERVER-RELATIVE paths native resolves against the configured origin and appends the media token (?mt=) to: src is the iOS-playable file route /api/offline/file/<kind>/<id> (never /track, which 503s while an ALAC rendition transcodes), artworkSrc one of /albumart/<id> or /podcastart/<subId>. clip (file seconds) marks one chapter of a file: positionSec, durationSec and seek are CLIP-RELATIVE, native ends the item at clip.endSec and Loop 'one' loops the clip. progress names the ONLINE route native POSTs plays and positions to (the same body the web sends; key is the id the web would save under: a chapter saves under its parent file id with FILE-absolute seconds) and radioSeed the seed native asks GET /api/music/radio with when 2 or fewer items are left (podcasts never carry one).",
      "type": "object",
      "required": ["kind", "id", "src", "title", "progress"],
      "properties": {
        "kind": { "enum": ["track", "podcastEpisode"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "src": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "title": { "type": "string", "maxLength": 1024 },
        "artist": { "type": "string", "maxLength": 1024 },
        "album": { "type": "string", "maxLength": 1024 },
        "artworkSrc": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "durationSec": { "type": "number", "minimum": 0 },
        "clip": { "type": "object", "required": ["startSec", "endSec"], "properties": { "startSec": { "type": "number", "minimum": 0 }, "endSec": { "type": "number", "minimum": 0 } } },
        "progress": { "type": "object", "required": ["route", "key"], "properties": { "route": { "enum": ["/api/music/progress", "/api/progress", "/api/podcasts/progress"] }, "key": { "type": "string", "minLength": 1, "maxLength": 512 } } },
        "radioSeed": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "audioModes": {
      "description": "v1.397.0 nativeAudio: the playback modes the web owns and native applies. loop 'one' repeats the current item (for a clip item: the chapter, D6); shuffle and autoplay are the web's Shuffle and Autoplay toggles (the web sends its queue in play order and mirrors native's radio appends, so native stays queue-dumb; autoplay off = stop at the end of the queue, no radio).",
      "type": "object",
      "required": ["autoplay", "shuffle", "loop"],
      "properties": { "autoplay": { "type": "boolean" }, "shuffle": { "type": "boolean" }, "loop": { "enum": ["off", "one"] } }
    },
    "audioSleep": {
      "description": "v1.397.0 nativeAudio: the sleep timer as native reports it. endsAt is epoch ms (only with mode 'minutes').",
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "enum": ["off", "minutes", "endOfItem"] }, "endsAt": { "type": "number", "minimum": 0 } }
    },
    "downloadItem": {
      "description": "One downloaded (or downloading) ITEM as native reports it: the fields of a 'download' event and of each 'downloadsSnapshot' element. kind is always a single-item kind; an album or season add reports its members, each carrying parentKind + parentId (FileTube Root ruling, 2026-10-11). state 'none' = not on the phone (removed, gone, cancelled). error only with 'failed'; localSrc only with 'done' (an opaque URL the web uses ONLY as a media element src). progress 0..1.",
      "type": "object",
      "required": ["kind", "id", "state"],
      "properties": {
        "kind": { "enum": ["track", "podcastEpisode", "video", "tvEpisode"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "state": { "enum": ["none", "queued", "downloading", "paused", "waitingForWifi", "done", "failed"] },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "bytes": { "type": "number", "minimum": 0 },
        "totalBytes": { "type": "number", "minimum": 0 },
        "error": { "enum": ["network", "storageFull", "revoked", "notOnServer", "notReady", "notPlayable", "other"] },
        "localSrc": { "type": "string", "minLength": 1 },
        "parentKind": { "enum": ["album", "tvSeason"] },
        "parentId": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "nativeToWeb": {
      "description": "event.detail of a 'filetube-host' CustomEvent native dispatches on window.",
      "type": "object",
      "required": ["v", "type"],
      "properties": { "v": { "const": 1 } },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "battery" },
            "level": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "state": { "enum": ["unplugged", "charging", "full", "unknown"] }
          },
          "required": ["level", "state"]
        },
        {
          "properties": {
            "type": { "const": "network" },
            "connection": { "enum": ["wifi", "cellular", "wired", "other", "none"] },
            "constrained": { "type": "boolean" },
            "expensive": { "type": "boolean" }
          },
          "required": ["connection"]
        },
        {
          "properties": {
            "type": { "const": "download" },
            "kind": { "enum": ["track", "podcastEpisode", "video", "tvEpisode"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 512 },
            "state": { "enum": ["none", "queued", "downloading", "paused", "waitingForWifi", "done", "failed"] },
            "progress": { "type": "number", "minimum": 0, "maximum": 1 },
            "bytes": { "type": "number", "minimum": 0 },
            "totalBytes": { "type": "number", "minimum": 0 },
            "error": { "enum": ["network", "storageFull", "revoked", "notOnServer", "notReady", "notPlayable", "other"] },
            "localSrc": { "type": "string", "minLength": 1 },
            "parentKind": { "enum": ["album", "tvSeason"] },
            "parentId": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "required": ["kind", "id", "state"]
        },
        {
          "properties": {
            "type": { "const": "downloadsAddFailed" },
            "kind": { "enum": ["track", "album", "podcastEpisode", "video", "tvEpisode", "tvSeason"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 512 },
            "error": { "enum": ["network", "storageFull", "revoked", "notOnServer", "notReady", "notPlayable", "other"] }
          },
          "required": ["kind", "id", "error"]
        },
        {
          "properties": {
            "type": { "const": "downloadsSnapshot" },
            "items": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/downloadItem" } }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "type": { "const": "audioState" },
            "rev": { "type": "number", "minimum": 0 },
            "queue": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/audioItem" } },
            "index": { "type": "number", "minimum": 0 },
            "state": { "enum": ["idle", "loading", "playing", "paused", "ended", "failed"] },
            "positionSec": { "type": "number", "minimum": 0 },
            "durationSec": { "type": "number", "minimum": 0 },
            "bufferedSec": { "type": "number", "minimum": 0 },
            "rate": { "type": "number", "minimum": 0.5, "maximum": 3 },
            "modes": { "$ref": "#/$defs/audioModes" },
            "sleep": { "$ref": "#/$defs/audioSleep" },
            "error": { "enum": ["network", "notPlayable", "revoked", "notOnServer", "other"] }
          },
          "required": ["rev", "queue", "index", "state", "positionSec", "durationSec", "rate", "modes", "sleep"]
        },
        {
          "properties": {
            "type": { "const": "audioTick" },
            "rev": { "type": "number", "minimum": 0 },
            "positionSec": { "type": "number", "minimum": 0 },
            "bufferedSec": { "type": "number", "minimum": 0 }
          },
          "required": ["rev", "positionSec"]
        },
        {
          "properties": {
            "type": { "const": "audioError" },
            "id": { "type": "string", "minLength": 1, "maxLength": 512 },
            "error": { "enum": ["network", "notPlayable", "revoked", "notOnServer", "other"] }
          },
          "required": ["id", "error"]
        }
      ]
    },
    "hostInfo": {
      "description": "GET /api/host-info response (public, no login).",
      "type": "object",
      "required": ["app", "version", "bridge"],
      "properties": {
        "app": { "const": "filetube" },
        "version": { "type": "string" },
        "bridge": {
          "type": "object",
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
        }
      }
    }
  }
}
