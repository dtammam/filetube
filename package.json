{
  "name": "filetube",
  "version": "1.344.2",
  "description": "A self-hosted media server resembling old-school YouTube",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --require ./test/helpers/tmp-cleanup.js --test test/*/*.test.js",
    "test:unit": "node --require ./test/helpers/tmp-cleanup.js --test test/unit/*.test.js",
    "lint": "eslint .",
    "lint:overlay": "node scripts/overlay-containment-lint.js --enforce",
    "lint:ui": "node scripts/ui-lint.js --enforce",
    "test:geometry": "node test/geometry/run.js",
    "test:geometry:fast": "node test/geometry/run.js --fast",
    "test:visual": "node test/visual/run.js",
    "audit:check": "node scripts/audit-check.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mime-types": "^2.1.35"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "Dean Tammam",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "css-tree": "^3.2.1",
    "eslint": "^9.39.4",
    "espree": "^10.4.0",
    "globals": "^17.11.0",
    "js-yaml": "^4.3.1",
    "jsdom": "^29.1.1"
  }
}
