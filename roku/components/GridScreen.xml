<?xml version="1.0" encoding="utf-8" ?>
<component name="GridScreen" extends="Group">
    <interface>
        <field id="serverUrl" type="string" />
        <field id="cookie" type="string" />
        <!-- Setting begin=true (re)loads the library from page zero. -->
        <field id="begin" type="boolean" alwaysNotify="true" onChange="onBegin" />
        <!-- Item the user picked; AppScene observes this to start playback.
             selectedIndex/queue are set BEFORE selectedItem fires so the
             observer reads a coherent trio: queue is the grid's own
             ContentNode (it keeps growing as pages append, so playback's
             next/autoplay sees new items for free).

             v1.47.3: alwaysNotify is LOAD-BEARING on selectedItem. Fields
             notify only on CHANGE, and re-picking the item you just watched
             assigns the SAME node reference -- so the observer never ran and
             the tile appeared dead until you selected something else
             (Dean on-device). Same one-shot-field class as loadError /
             authExpired. It also un-sticks a tile whose resume prompt was
             back-dismissed. selectedIndex is NOT observed by anyone today
             (AppScene reads it as a plain value inside the selectedItem
             callback); it carries alwaysNotify defensively, so a future
             direct observer starts out correct. -->
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <field id="selectedIndex" type="integer" value="-1" alwaysNotify="true" />
        <field id="queue" type="node" />
        <!-- Playback prefetch: AppScene sets the index it will need next;
             the grid loads another page when that nears the loaded tail. -->
        <field id="ensureLoaded" type="integer" alwaysNotify="true" onChange="onEnsureLoaded" />
        <!-- Gate W7 (v1.47): while AppScene's playback gate shows
             "Preparing…", the hidden grid keeps focus -- swallow its keys
             (except Back, which must bubble up to cancel the gate). -->
        <field id="gateActive" type="boolean" value="false" />
        <!-- Non-empty when a page fetch failed; AppScene shows the dialog. -->
        <field id="loadError" type="string" alwaysNotify="true" />
        <!-- True when the server said our session is no longer valid. -->
        <field id="authExpired" type="boolean" value="false" alwaysNotify="true" />
        <field id="takeFocus" type="boolean" alwaysNotify="true" onChange="onTakeFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/GridScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <children>
        <Label id="headerLabel" translation="[64,40]" font="font:MediumBoldSystemFont" color="0xF1F1F1FF" text="FileTube" />
        <Label id="libHint" translation="[1000,56]" width="856" horizAlign="right" font="font:SmallestSystemFont" color="0x9A9A9AFF" text="" visible="false" />
        <Label id="countLabel" translation="[64,92]" font="font:SmallestSystemFont" color="0x9A9A9AFF" />
        <Label id="emptyLabel" translation="[64,300]" font="font:MediumSystemFont" color="0x9A9A9AFF" text="No videos found in the library." visible="false" />
        <MarkupGrid
            id="grid"
            translation="[64,140]"
            itemComponentName="GridItem"
            itemSize="[336,252]"
            itemSpacing="[24,28]"
            numColumns="5"
            numRows="3"
            vertFocusAnimationStyle="floatingFocus" />
        <!-- Libraries picker: opened with Left from the grid. -->
        <Rectangle id="folderScrim" translation="[0,0]" width="1920" height="1080" color="0x000000C8" visible="false" />
        <Label id="folderTitle" translation="[64,120]" font="font:MediumBoldSystemFont" color="0xF1F1F1FF" text="Libraries" visible="false" />
        <LabelList id="folderMenu" translation="[64,200]" itemSize="[640,64]" itemSpacing="[0,4]" visible="false" />
    </children>
</component>
