<?xml version="1.0" encoding="utf-8" ?>
<component name="ShowItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ShowItem.brs" />
    <children>
        <!-- A 2:3 poster tile (the web Shows page's poster wall). /tvposter and
             /tvthumb are FIRST-PARTY, so HDPosterUrl + the inherited scene
             HttpAgent is correct here (the ChannelItem roHttpAgent split is for
             REMOTE avatar hosts only — gate W6). scaleToZoom = cover (fills the
             box, crops the excess); a show with no 2:3 poster art falls back to a
             16:9 episode thumbnail, and cover keeps the tile full-bleed (the web
             page's object-fit:cover parity).

             v1.199.2: the title/meta labels EXACTLY mirror the app's proven
             GridItem/ChannelItem pattern - single-line, non-wrapping labels at a
             28px pitch. A long name CLIPS at the 256px tile edge (the video grid's
             own behaviour) rather than wrapping; the wrapped-2-line title shipped
             in v1.199.1 overflowed its real on-device line height onto the count
             lines (Dean on-device). Two stacked count lines: seasons, then
             episodes. -->
        <Rectangle id="posterBg" width="256" height="384" color="0x2A2A2AFF" />
        <Poster id="poster" width="256" height="384" loadWidth="256" loadHeight="384" loadDisplayMode="scaleToZoom" />
        <Label id="titleLabel" translation="[0,392]" width="256" font="font:SmallestSystemFont" color="0xF1F1F1FF" />
        <!-- metaTop is always shown; metaBottom is shown only for the shows wall
             (seasons wall leaves it empty -> hidden). Single-line each, 28px pitch
             (the GridItem title->dur spacing, on-device-proven). -->
        <Label id="metaTop" translation="[0,420]" width="256" font="font:SmallestSystemFont" color="0x9A9A9AFF" />
        <Label id="metaBottom" translation="[0,448]" width="256" font="font:SmallestSystemFont" color="0x9A9A9AFF" />
    </children>
</component>
