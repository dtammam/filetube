<?xml version="1.0" encoding="utf-8" ?>
<component name="ShowItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/ShowItem.brs" />
    <children>
        <!-- A 2:3 poster tile (the web Shows page's poster wall). /tvposter and
             /tvthumb are FIRST-PARTY, so HDPosterUrl + the inherited scene
             HttpAgent is correct here (the ChannelItem roHttpAgent split is for
             REMOTE avatar hosts only — gate W6). scaleToZoom = cover (fills the
             box, crops the excess); a show with no 2:3 poster art falls back to a
             16:9 episode thumbnail, and cover keeps the tile full-bleed (the web
             page's object-fit:cover parity). Tile widened v1.199.1 (216 -> 256)
             so posters read from the couch; title wraps 2 lines with an ellipsis
             so a long name can never paint over the meta, and the season/episode
             counts are split onto their own lines. -->
        <Rectangle id="posterBg" width="256" height="384" color="0x2A2A2AFF" />
        <Poster id="poster" width="256" height="384" loadWidth="256" loadHeight="384" loadDisplayMode="scaleToZoom" />
        <Label id="titleLabel" translation="[0,394]" width="256" wrap="true" maxLines="2" font="font:SmallestSystemFont" color="0xF1F1F1FF" />
        <!-- metaTop is always shown; metaBottom is shown only for the shows wall
             (seasons wall leaves it empty -> hidden). Positioned below the title's
             2-line max so a wrapped title never collides with the counts. -->
        <Label id="metaTop" translation="[0,448]" width="256" font="font:SmallestSystemFont" color="0x9A9A9AFF" />
        <Label id="metaBottom" translation="[0,474]" width="256" font="font:SmallestSystemFont" color="0x9A9A9AFF" />
    </children>
</component>
