#!/usr/bin/env bash
# Pre-commit hook — fast gate before every commit: lint + unit tests.
# Full integration tests run on pre-push instead, to keep commits snappy.
set -euo pipefail

# Source profile for tool paths (nvm, etc.)
[ -f "$HOME/.profile" ] && source "$HOME/.profile" 2>/dev/null || true

echo "Running pre-commit checks..."

# Resolve node_modules the way Node does - walking UP from the worktree - so a
# git worktree under .claude/worktrees/ (which shares the main checkout's
# install through the parent directories) passes without a symlink (#227).
dir="$PWD"
found=""
while [ "$dir" != "/" ]; do
  if [ -d "$dir/node_modules" ]; then found="$dir/node_modules"; break; fi
  dir="$(dirname "$dir")"
done
if [ -z "$found" ]; then
  echo "⚠ node_modules missing (looked in $PWD and every parent) — run 'npm install' before committing." >&2
  exit 1
fi
# (npm itself already puts every ancestor node_modules/.bin on its scripts'
# PATH, so the walk is the whole fix - nothing else is needed for a worktree.)

# DOCS-ONLY FAST PATH (Dean, 2026-09-24): a commit whose every staged path is
# Markdown under docs/ (gate verdicts, fix records, plan close-outs) runs only
# the unit tests that read docs/, not the whole suite. The selector lives
# beside THIS hook (core.hooksPath is shared by every worktree, and an older
# branch may not carry the script); if it is missing, or it finds no
# docs-reading test, the full checks below run. pre-push still runs everything.
fast_path="$(dirname "$0")/../scripts/precommit-docs-fast-path.js"
if [ -f "$fast_path" ] && docs_tests="$(node "$fast_path")"; then
  echo "→ docs-only commit: the docs-reading unit tests"
  mapfile -t docs_test_files <<< "$docs_tests"
  node --require ./test/helpers/tmp-cleanup.js --test "${docs_test_files[@]}"
  echo "Pre-commit checks passed (docs-only)."
  exit 0
fi

# Lint (fails on errors, not warnings)
echo "→ eslint"
npm run --silent lint

# THE TOKEN RATCHET (v1.62.0): the census hit zero at v1.61.0 and stays
# there - any raw literal in a governed style property fails the commit
# (adopt a token, use a recognized idiom, or annotate token-exempt with a
# reason; docs/CONTRIBUTING.md, MANDATORY styling section). Runs its own
# known-violation canary first, so a broken linter fails LOUD, never
# passes quiet.
echo "→ token ratchet (lint:css --enforce)"
node scripts/css-token-lint.js --enforce

# Fast unit tests only (no server boot)
echo "→ unit tests"
npm run --silent test:unit

echo "Pre-commit checks passed."
