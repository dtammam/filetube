#!/usr/bin/env bash
# Pre-push hook — full gate before pushing: lint + the complete test suite
# (unit + integration).
set -euo pipefail

# Source profile for tool paths (nvm, etc.)
[ -f "$HOME/.profile" ] && source "$HOME/.profile" 2>/dev/null || true

echo "Running pre-push checks..."

# Resolve node_modules the way Node does - walking UP from the worktree - so a
# git worktree under .claude/worktrees/ (which shares the main checkout's
# install through the parent directories) passes without a symlink (#227).
dir="$PWD"
found=""
while [ "$dir" != "/" ]; do
  if [ -d "$dir/node_modules" ]; then found="$dir/node_modules"; break; fi
  dir="$(dirname "$dir")"
done
if [ -z "$found" ]; then
  echo "⚠ node_modules missing (looked in $PWD and every parent) — run 'npm install' before pushing." >&2
  exit 1
fi
# npm resolves its scripts' binaries from the CURRENT package's node_modules/.bin
# only, so a worktree borrows the found install's .bin on PATH.
export PATH="$found/.bin:$PATH"

echo "→ eslint"
npm run --silent lint

echo "→ full test suite"
npm test

echo "Pre-push checks passed."
