#!/usr/bin/env bash
# Pre-push hook — full gate before pushing: lint + the complete test suite
# (unit + integration).
set -euo pipefail

# Source profile for tool paths (nvm, etc.)
[ -f "$HOME/.profile" ] && source "$HOME/.profile" 2>/dev/null || true

echo "Running pre-push checks..."

# Resolve node_modules the way Node does - walking UP from the worktree - so a
# git worktree under .claude/worktrees/ (which shares the main checkout's
# install through the parent directories) passes without a symlink (#227).
dir="$PWD"
found=""
while [ "$dir" != "/" ]; do
  if [ -d "$dir/node_modules" ]; then found="$dir/node_modules"; break; fi
  dir="$(dirname "$dir")"
done
if [ -z "$found" ]; then
  echo "⚠ node_modules missing (looked in $PWD and every parent) — run 'npm install' before pushing." >&2
  exit 1
fi
# (npm itself already puts every ancestor node_modules/.bin on its scripts'
# PATH, so the walk is the whole fix - nothing else is needed for a worktree.)

echo "→ eslint"
npm run --silent lint

echo "→ ui ratchet (lint:ui --enforce)"
npm run --silent lint:ui

echo "→ full test suite"
npm test

# Geometry G1-G3 fast set (UI professionalism pass, plan D10.2, ~10s): only when
# public/ changed against the upstream (or origin/main). Row columns, icon centring and
# equal heights in a button group, on the seeded instance; a listed expected failure
# (test/geometry/expected-failures.json) is XFAIL, an unlisted one fails the push.
geo_up="$(git rev-parse --verify -q '@{upstream}' 2>/dev/null || git rev-parse --verify -q origin/main 2>/dev/null || true)"
if [ -z "$geo_up" ] || ! git diff --quiet "$(git merge-base HEAD "$geo_up")" HEAD -- public/; then
  echo "→ geometry (fast): public/ changed"
  npm run --silent test:geometry:fast
fi

echo "Pre-push checks passed."
