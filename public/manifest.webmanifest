{
  "name": "FileTube",
  "short_name": "FileTube",
  "description": "Self-hosted, nostalgic-YouTube media server.",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f0f0f",
  "theme_color": "#cc0000",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Music", "short_name": "Music", "url": "/music", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Now Playing", "short_name": "Now Playing", "url": "/music?nowplaying=1", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Shuffle Songs", "short_name": "Shuffle", "url": "/music?mode=shuffle", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Podcasts", "short_name": "Podcasts", "url": "/podcasts", "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
